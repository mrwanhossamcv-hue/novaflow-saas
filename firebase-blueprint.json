{
  "entities": {
    "VerificationSession": {
      "title": "VerificationSession",
      "description": "Tracks a user's multi-step email and phone SMS OTP verification state.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Authenticated Firebase user UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified non-disposable email address.",
          "minLength": 5,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "description": "Verified E.164 phone number.",
          "minLength": 8,
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "enum": ["UNVERIFIED", "EMAIL_VERIFIED", "PHONE_VERIFIED", "FULLY_VERIFIED", "PAYMENT_LOCKED"],
          "description": "Current verification state."
        }
      },
      "required": ["uid", "email", "phone", "status"]
    }
  },
  "firestore": {
    "/verificationSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/VerificationSession" },
      "description": "Owner-isolated verification session records."
    }
  }
}
